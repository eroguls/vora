generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
  CONTENT_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentType {
  SHORT_TEXT
  PHOTO
  GALLERY
  SHORT_VIDEO
  LONG_VIDEO
  ARTICLE
  AUDIO
  MIXED
}

enum ContentStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  HIDDEN
  DELETED
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  UNLISTED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AccountProvider {
  EMAIL
  GOOGLE
}

enum NotificationType {
  NEW_FOLLOWER
  LIKE
  COMMENT
  COMMENT_REPLY
  QUOTE_SHARE
  CONTENT_SHARE
  MENTION
  MEDIA_PROCESSING_COMPLETED
  MEDIA_PROCESSING_FAILED
  MODERATION_RESULT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  COPYRIGHT
  PRIVACY_VIOLATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum ModerationActionType {
  HIDE_CONTENT
  RESTORE_CONTENT
  WARN_USER
  TEMP_SUSPEND_USER
  PERMANENT_SUSPEND_USER
  DISMISS_REPORT
}

enum MessageType {
  TEXT
  PHOTO
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String               @unique
  displayName         String
  passwordHash        String
  role                UserRole             @default(USER)
  adminRole           AdminRole?
  status              UserStatus           @default(ACTIVE)
  isVerified          Boolean              @default(false)
  birthDate           DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  devices             Device[]
  contents            Content[]            @relation("UserContents")
  media               Media[]              @relation("MediaOwner")
  likes               Like[]               @relation("UserLikes")
  comments            Comment[]            @relation("CommentAuthor")
  commentLikes        CommentLike[]        @relation("CommentLikeUser")
  shares              Share[]              @relation("ShareUser")
  bookmarks           Bookmark[]           @relation("BookmarkUser")
  following           Follow[]             @relation("UserFollowing")
  followers           Follow[]             @relation("UserFollowers")
  blocksInitiated     Block[]              @relation("Blocker")
  blocksReceived      Block[]              @relation("Blocked")
  mutesInitiated      Mute[]               @relation("Muter")
  mutesReceived       Mute[]               @relation("Muted")
  mentionedIn         Mention[]            @relation("MentionedUser")
  notifications       Notification[]       @relation("NotificationRecipient")
  actedNotifications  Notification[]       @relation("NotificationActor")
  conversationMembers ConversationMember[]
  sentMessages        Message[]            @relation("MessageSender")
  readMessages        MessageRead[]        @relation("MessageReadUser")
  reportsMade         Report[]             @relation("Reporter")
  reportsAgainstUser  Report[]             @relation("ReportedUser")
  moderationCases     ModerationCase[]     @relation("CaseSubjectUser")
  assignedCases       ModerationCase[]     @relation("AssignedAdmin")
  moderationActions   ModerationAction[]   @relation("ModerationAdmin")
  searchQueries       SearchQuery[]
  searchClicks        SearchClick[]
  viewEvents          ViewEvent[]
  feedImpressions     FeedImpression[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([createdAt])
  @@index([status])
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl           String?
  coverUrl            String?
  bio                 String?
  about               String?
  profession          String?
  country             String?
  city                String?
  languages           String[] @default([])
  links               Json     @default("[]")
  contactVisibility   String   @default("FOLLOWERS")
  isIndexable         Boolean  @default(true)
  followerCount       Int      @default(0)
  followingCount      Int      @default(0)
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([country])
  @@index([city])
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AccountProvider
  providerAccountId String
  createdAt         DateTime        @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  userAgent String?
  ipAddress String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  id       String   @id @default(cuid())
  muterId  String
  mutedId  String
  muter    User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted    User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([mutedId])
}

model Location {
  id        String    @id @default(cuid())
  country   String
  city      String?
  region    String?
  latitude  Float?
  longitude Float?
  contents  Content[]
  createdAt DateTime  @default(now())

  @@index([country])
  @@index([city])
}

model Content {
  id               String             @id @default(cuid())
  authorId         String
  author           User               @relation("UserContents", fields: [authorId], references: [id], onDelete: Cascade)
  slug             String
  contentType      ContentType
  status           ContentStatus      @default(DRAFT)
  title            String?
  body             String?
  excerpt          String?
  language         String             @default("tr")
  originalLanguage String             @default("tr")
  visibility       Visibility         @default(PUBLIC)
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  locationId       String?
  location         Location?          @relation(fields: [locationId], references: [id])
  metadata         Json               @default("{}")
  searchVector     Unsupported("tsvector")?
  viewCount        Int                @default(0)
  likeCount        Int                @default(0)
  commentCount     Int                @default(0)
  shareCount       Int                @default(0)
  saveCount        Int                @default(0)
  media            Media[]
  likes            Like[]
  comments         Comment[]
  shares           Share[]
  bookmarks        Bookmark[]
  hashtags         ContentHashtag[]
  mentions         Mention[]          @relation("ContentMentions")
  notifications    Notification[]
  reports          Report[]           @relation("ReportedContent")
  moderationCases  ModerationCase[]   @relation("CaseContent")
  searchClicks     SearchClick[]
  viewEvents       ViewEvent[]
  feedImpressions  FeedImpression[]
  translations     Translation[]
  processingJobs   ProcessingJob[]

  @@unique([authorId, slug])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([contentType])
  @@index([status])
  @@index([locationId])
  @@index([authorId, publishedAt])
}

model Media {
  id               String           @id @default(cuid())
  contentId        String?
  content          Content?         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User             @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  mediaType        MediaType
  storageKey       String           @unique
  publicUrl        String
  thumbnailUrl     String?
  mimeType         String
  width            Int?
  height           Int?
  duration         Float?
  fileSize         Int?
  processingStatus ProcessingStatus @default(PENDING)
  sortOrder        Int              @default(0)
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  processingJobs   ProcessingJob[]

  @@index([contentId])
  @@index([ownerId])
  @@index([mediaType])
  @@index([processingStatus])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([contentId])
}

model Comment {
  id           String        @id @default(cuid())
  contentId    String
  authorId     String
  parentId     String?
  body         String
  deletedAt    DateTime?
  likeCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  content      Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author       User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  likes        CommentLike[]
  mentions     Mention[]     @relation("CommentMentions")
  notifications Notification[]

  @@index([contentId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  user      User     @relation("CommentLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Share {
  id            String   @id @default(cuid())
  userId        String
  contentId     String
  quoteBody     String?
  quotedContentId String?
  user          User     @relation("ShareUser", fields: [userId], references: [id], onDelete: Cascade)
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([contentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation("BookmarkUser", fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([contentId])
}

model Hashtag {
  id        String           @id @default(cuid())
  name      String           @unique
  contents  ContentHashtag[]
  createdAt DateTime         @default(now())
}

model ContentHashtag {
  id        String   @id @default(cuid())
  contentId String
  hashtagId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([contentId, hashtagId])
  @@index([hashtagId])
}

model Mention {
  id              String   @id @default(cuid())
  contentId       String?
  commentId       String?
  mentionedUserId String
  content         Content? @relation("ContentMentions", fields: [contentId], references: [id], onDelete: Cascade)
  comment         Comment? @relation("CommentMentions", fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([mentionedUserId])
  @@index([contentId])
  @@index([commentId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  contentId   String?
  commentId   String?
  type        NotificationType
  title       String
  body        String?
  href        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  content     Content?         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([type])
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  mutedAt        DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType   @default(TEXT)
  body           String?
  mediaUrl       String?
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads          MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("MessageReadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  contentId      String?
  reportedUserId String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  content        Content?     @relation("ReportedContent", fields: [contentId], references: [id], onDelete: Cascade)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  moderationCases ModerationCase[]

  @@index([status])
  @@index([contentId])
  @@index([reportedUserId])
}

model ModerationCase {
  id              String               @id @default(cuid())
  reportId        String?
  contentId       String?
  userId          String?
  assignedAdminId String?
  status          ModerationCaseStatus @default(OPEN)
  summary         String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  report          Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  content         Content?             @relation("CaseContent", fields: [contentId], references: [id], onDelete: SetNull)
  user            User?                @relation("CaseSubjectUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin   User?                @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  actions         ModerationAction[]

  @@index([status])
  @@index([assignedAdminId])
}

model ModerationAction {
  id        String               @id @default(cuid())
  caseId    String
  adminId   String
  type      ModerationActionType
  note      String?
  createdAt DateTime             @default(now())
  case      ModerationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  admin     User                 @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([adminId])
}

model SearchQuery {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  filters   Json          @default("{}")
  resultCount Int         @default(0)
  createdAt DateTime      @default(now())
  clicks    SearchClick[]

  @@index([query])
  @@index([createdAt])
}

model SearchClick {
  id            String      @id @default(cuid())
  searchQueryId String
  userId        String?
  contentId     String?
  position      Int
  createdAt     DateTime    @default(now())
  searchQuery   SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  content       Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([searchQueryId])
  @@index([contentId])
}

model ViewEvent {
  id        String   @id @default(cuid())
  userId    String?
  contentId String
  ipHash    String?
  duration  Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([userId])
}

model FeedImpression {
  id        String   @id @default(cuid())
  userId    String?
  contentId String
  position  Int
  score     Float
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([contentId])
}

model Translation {
  id        String   @id @default(cuid())
  contentId String
  language  String
  provider  String
  title     String?
  body      String?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, language, provider])
  @@index([language])
}

model ProcessingJob {
  id        String           @id @default(cuid())
  contentId String?
  mediaId   String?
  queueName String
  status    ProcessingStatus @default(PENDING)
  attempts  Int              @default(0)
  error     String?
  payload   Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  content   Content?         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([queueName])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  rules       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
